{
  "name": "@civilcraft/game-schema",
  "private": true,
  "type": "module",
  "exports": {
    "./common/*": "./common/*.ts",
    "./rest/*": "./rest/*.ts",
    "./websocket/*": "./websocket/*.ts"
  },
  "typesVersions": {
