# 環境変数の説明: docs/development/environment-variables.md
# 使い方: cp .env.example .env

# PostgreSQL（docker-compose + apps/server）
POSTGRES_USER=civilcraft
POSTGRES_PASSWORD=civilcraft
POSTGRES_DB=civilcraft
POSTGRES_PORT=5432
DATABASE_URL=postgres://civilcraft:civilcraft@localhost:5432/civilcraft?sslmode=disable

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Server（apps/server）
API_ADDR=:8080
GAME_ADDR=:8081
# Main Backend -> NPC Backend（ローカルでは同じ値を両プロセスに設定）
NPC_BACKEND_URL=http://127.0.0.1:8082
NPC_BACKEND_ADDR=127.0.0.1:8082
# 本番ではSecret管理機能で十分に長いランダム値を設定する
NPC_BACKEND_TOKEN=local-npc-backend-token
# NPC Backendだけが参照する。openai / ollama / fixed
NPC_LLM_PROVIDER=fixed
NPC_LLM_BASE_URL=http://127.0.0.1:11434
NPC_LLM_MODEL=qwen3:14b
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEYはファイルへ記載せず、実行環境のSecretとして設定する
# リポジトリルートからの相対パス、または絶対パス
GAME_DATA_DIR=packages/game-data

# Web（apps/web / Vite）
# 開発時は Vite の /ws プロキシ経由。未設定時も /ws を使う
# VITE_GAME_WS_URL=ws://127.0.0.1:8081/ws
VITE_GAME_WS_URL=/ws
